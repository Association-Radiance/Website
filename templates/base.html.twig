<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Organisateur de tournoi en physique sur le jeu Dota 2" />
        <meta name="author" content="Association Radiance" />

        <link rel="apple-touch-icon" sizes="180x180" href="{{ absolute_url('/favicon/apple-touch-icon.png') }}" />
        <link rel="icon" type="image/png" sizes="32x32" href="{{ absolute_url('/favicon/favicon-32x32.png') }}" />
        <link rel="icon" type="image/png" sizes="16x16" href="{{ absolute_url('/favicon/favicon-16x16.png') }}" />
        <link rel="manifest" href="{{ absolute_url('/favicon/site.webmanifest') }}" />

        <title>
            {% block title %}
                Association Radiance
            {% endblock %}
        </title>

        {% block stylesheets %}

        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}

            <script src="{{ asset('handleMenu.js') }}"></script>
        {% endblock %}
    </head>

    <body>
        <header class="base-header">
            <nav class="navbar">
                <a href="/" class='navbar-logo'>
                    <img src="{{ asset('images/logo.webp') }}" alt="Association Radiance"  />
                </a>

                <div class="navbar-menu" id="menu">
                    <a href="/edition-2026" class="navbar-link">Radiance LAN 2026</a>
                    <a href="/editions-precedentes" class="navbar-link">Éditions précédentes</a>
                    <a href="/donation" class="navbar-link">Nous soutenir</a>
                    <a href="/contact" class="navbar-link">Nous contacter</a>
                </div>

                <button id="menu-button" class="navbar-menu-control" type="button">{{ include('svg/icons/menu-line.svg.twig') }}</span>
            </nav>
        </header>

        <main id="main" class="base-main">
            {% block main %}

            {% endblock %}
        </main>

        <footer class="base-footer">
            <div class="footer-container">
                <a href="https://www.instagram.com/association_radiance" class="footer-link" target="_blank">
                    <img
                        src="{{ asset('images/icons/instagram-fill.png') }}"
                        alt="Instagram"
                        aria-label="Instagram"
                    />
                </a>
                <a href="https://discord.com/invite/mcdVebJYXb" class="footer-link" target="_blank">
                    <img src="{{ asset('images/icons/discord-fill.png') }}" alt="Discord" aria-label="Discord" />
                </a>
            </div>
        </footer>
    </body>
</html>
