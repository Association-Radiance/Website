{% extends 'base.html.twig' %}

{% block title %}
    Hello AdminController!
{% endblock %}

{% block body %}
    {% for donation in donations %}
        <div style="display: flex; border:1px solid white; gap:32px">
            <p>
                {{ donation.id }}
            </p>
            <p>
                {{ donation.helloAssoId }}
            </p>
            <p>
                {{ (donation.amount / 100)|number_format(2) }} €
            </p>
            <p>
                {{ donation.date|date('d/m/Y H:i', timezone: 'Europe/Paris') }}
            </p>
        </div>
    {% endfor %}

    <p>
        {{ (total / 100)|number_format(2) }} €
    </p>
{% endblock %}
