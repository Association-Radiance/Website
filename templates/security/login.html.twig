{% extends 'base.html.twig' %} {% block title %} Log in! {% endblock %} {% block body %}

<main id="main">
    <section>
        <div class="container">
            <form method="post" class="form-container login-form">
                <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>

                <div class="form-field">
                    <label for="username">Username</label>
                    <input type="text" name="_username" id="username" class="form-input" autocomplete="username" required autofocus />
                </div>

                <div class="form-field">
                    <label for="password">Password</label>
                    <input type="password" name="_password" id="password" class="form-input" autocomplete="current-password" required />
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

                <div>
                    {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <button class="form-submit" type="submit">Connexion</button>
                </div>
            </form>
        </div>
    </section>
</main>

{% endblock %}
