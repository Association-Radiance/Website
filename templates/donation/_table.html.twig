<table>
    <thead class="table-head">
        <tr class="table-row">
            <th class="table-cell text-left">Id</th>
            <th class="table-cell text-left">Id HelloAsso</th>
            <th class="table-cell text-left">Date</th>
            <th class="table-cell text-right">Montant</th>
            <th class="table-cell text-right">Action</th>
        </tr>
    </thead>

    <tbody>
        {% for donation in donations %}
            {% include 'donation/_row.html.twig' %}
        {% endfor %}
    </tbody>

    <tfoot>
        <tr class="table-row">
            <td class="table-cell text-left" colspan="3">Total</td>
            <td class="table-cell text-right">{{ (total / 100)|number_format(2) }} €</td>
            <td class="table-cell"></td>
        </tr>
    </tfoot>
</table>
