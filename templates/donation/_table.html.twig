<table>
    <thead class="table-head">
        <tr class="table-row">
            <th class="table-cell text-left table-cell-fixed">Date</th>
            <th class="table-cell text-left table-cell-flexible">Id HelloAsso</th>
            <th class="table-cell text-right table-cell-fixed">Montant</th>
            <th class="table-cell text-right"></th>
        </tr>
    </thead>

    <tbody>
        {% for donation in donations %}
            <tr class="table-row" id="donation_{{ donation.id }}">
                <td class="table-cell text-left table-cell-fixed">
                    {{ donation.date|date('d/m/Y H:i', timezone: 'Europe/Paris') }}
                </td>
                <td class="table-cell text-left table-cell-flexible">{{ donation.helloAssoId }}</td>
                <td class="table-cell text-right table-cell-fixed">{{ (donation.amount / 100)|number_format(2) }} €</td>
                <td class="table-cell text-right table-cell-fixed">
                    <div class="table-action">
                        <a
                            href="{{
                            path(
                                'donation_edit',
                                {
                                    id: donation.id
                                }
                            )
                            }}"
                            data-turbo-frame="donation_modal"
                            class="button button-primary button-outline"
                        >
                            {{ include('svg/icons/pencil-line.svg.twig') }}
                        </a>
                        <form
                            method="delete"
                            action="{{
                            path(
                                'donation_delete',
                                {
                                    id: donation.id
                                }
                            )
                            }}"
                        >
                            <button
                                type="submit"
                                class="button button-primary button-outline"
                                data-turbo-confirm="Supprimer cette donation ?"
                            >
                                {{ include('svg/icons/delete-bin-line.svg.twig') }}
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
    </tbody>

    <tfoot>
        <tr class="table-row">
            <td class="table-cell text-left" colspan="2">Total</td>
            <td class="table-cell text-right table-cell-fixed">{{ (total / 100)|number_format(2) }} €</td>
            <td class="table-cell"></td>
        </tr>
    </tfoot>
</table>
