<turbo-frame id="donation_modal">
    <dialog
        class="dialog"
        data-controller="dialog"
        data-dialog-target="dialog"
        data-action="click->dialog#closeOnBackdrop"
    >
        <header class="dialog-header">
            <h2 class="dialog-title">{{ title }}</h2>

            <button
                type="button"
                class="button button-primary dialog-close"
                aria-label="Fermer"
                data-action="dialog#close"
            >
                {{ include('svg/icons/close-line.svg.twig') }}
            </button>
        </header>

        {{ form_start(form, {attr: {'data-turbo-stream': 'true'}}) }}

        <div class="dialog-body">
            {{ form_errors(form) }}

            <div class="form">
                <div class="form-field">
                    <div class="form-label">
                        {{ form_label(form.helloAssoId) }}
                        {{ form_errors(form.helloAssoId) }}
                    </div>

                    {{ form_widget( form.helloAssoId, { attr: { class: 'form-input' } } ) }}
                </div>

                <div class="form-field">
                    <div class="form-label">
                        {{ form_label(form.amount) }}
                        {{ form_errors(form.amount) }}
                    </div>

                    {{ form_widget( form.amount, { attr: { class: 'form-input' } } ) }}
                </div>

                <div class="form-field">
                    <div class="form-label">
                        {{ form_label(form.date) }}
                        {{ form_errors(form.date) }}
                    </div>

                    {{ form_widget( form.date, { attr: { class: 'form-input' } } ) }}
                </div>
            </div>
        </div>

        <footer class="dialog-footer">
            <button type="button" class="button button-secondary button-outline" data-action="dialog#close">
                Annuler
            </button>

            <button type="submit" class="button button-secondary button-outline">Enregistrer</button>
        </footer>

        {{ form_end(form) }}
    </dialog>
</turbo-frame>
