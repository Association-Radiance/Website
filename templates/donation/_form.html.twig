<turbo-frame id="donation_modal">
    <dialog class="donation-dialog" data-controller="dialog" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop">
        <div class="dialog-header">
            <h2 class="dialog-title">{{ title }}</h2>

            <button type="button" class="dialog-close" aria-label="Fermer" data-action="dialog#close">&times;</button>
        </div>

        {{ form_start(form, {attr: {'data-turbo-stream': 'true'}}) }}

        <div class="dialog-body">
            {{ form_errors(form) }}

            <div class="form-group">
                {{ form_label(form.helloAssoId) }}
                {{ form_widget( form.helloAssoId,{attr: {class: 'form-input'}}) }}
                {{ form_errors(form.helloAssoId) }}
            </div>

            <div class="form-group">
                {{ form_label(form.amount) }}
                {{ form_widget( form.amount, { attr: { class: 'form-input', min: 1 } } ) }}
                {{ form_errors(form.amount) }}
            </div>

            <div class="form-group">
                {{ form_label(form.date) }}
                {{ form_widget( form.date, { attr: { class: 'form-input' } } ) }}
                {{ form_errors(form.date) }}
            </div>
        </div>

        <div class="dialog-footer">
            <button type="button" class="btn btn-secondary" data-action="dialog#close">Annuler</button>

            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>

        {{ form_end(form) }}
    </dialog>
</turbo-frame>
