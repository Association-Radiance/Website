{% extends 'base.html.twig' %}

{% block title %}
    Édition 2026 - Association Radiance
{% endblock %}

{% block main %}
    <section
        class="section section-background section-full-height"
        style="background-image: url({{ asset('images/background/background-lan2025.webp') }});"
    >
        <div class="section-container">
            <h2 class="section-title text-accent">Radiance LAN 2026</h2>

            <div class="section-content">
                <div class="content">
                    <img
                        src="{{ asset('images/radiance-lan.webp') }}"
                        alt="Radiance LAN"
                        width="200px"
                        height="200px"
                    />

                    <p class="text-center">
                        Le plus grand tournoi Dota 2 francophone, en format LAN !
                    </p>

                    <ul class="announcement">
                        <li>Évenement du 24 au 25 octobre 2026</li>
                        <li>Au CRIJ Centre-Val de Loire, 3 Rue de la Cholerie, Orléans</li>
                        <li>16 équipes</li>
                        <li>Jusqu'à 1000€ de cashprize</li>
                    </ul>

                    <div class="announcement">
                        <p class="text-center">
                            Rendez-Vous du 23 au 25 octobre sur notre chaine Twitch pour suivre la Radiance LAN 2026 en
                            direct
                        </p>

                        <div style="display: flex; gap: 32px">
                            <a href="https://www.twitch.tv/association_radiance" class="button button-accent button-lg">
                                {{ include('svg/socials/twitch-fill.svg.twig') }}
                                Twitch
                            </a>

                            <a
                                href="https://liquipedia.net/dota2/Association_Radiance/Radiance_LAN/2026"
                                class="button button-accent button-lg"
                            >
                                {{ include('svg/icons/file-chart-fill.svg.twig') }}
                                Liquipedia
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
