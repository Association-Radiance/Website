{% extends 'base.html.twig' %}

{% block title %}
    Contact - Association Radiance
{% endblock %}

{% set successMessages = app.flashes('success') %}
{% set errorMessages = app.flashes('error') %}

{% block main %}
<section
    class="section section-background section-full-height"
    style="background-image: url({{ asset('images/background/background-contact.webp') }});"
>
    <div class="section-container">
            <h2 class='section-title'>Nous contacter</h2>

            <div class="section-content">
                <div class="content">
                    <turbo-frame id="contact-form">
                        {{ form_start(form, { 'attr': { 'class': 'form-container', 'autocomplete' : 'off'}}  ) }}
                            <div class="form-field">
                                <div class="form-label">
                                    {{ form_label(form.name) }}
                                    {{ form_errors(form.name) }}
                                </div>

                                {{ form_widget(form.name, {'attr': {'class': 'form-input'}}) }}
                            </div>

                            <div class="form-field">
                                <div class="form-label">
                                    {{ form_label(form.email) }}
                                    {{ form_errors(form.email) }}
                                </div>
                                {{ form_widget(form.email, {'attr': {'class': 'form-input'}}) }}
                            </div>

                            <div class="form-field">
                                <div class="form-label">
                                    {{ form_label(form.telephone) }}
                                    {{ form_errors(form.telephone) }}
                                </div>
                                {{ form_widget(form.telephone, {'attr': {'class': 'form-input'}}) }}
                            </div>

                            <div class="form-field">
                                <div class="form-label">
                                    {{ form_label(form.company) }}
                                    {{ form_errors(form.company) }}
                                </div>
                                {{ form_widget(form.company, {'attr': {'class': 'form-input'}}) }}
                            </div>

                            <div class="form-field">
                                <div class="form-label">
                                    {{ form_label(form.subject) }}
                                    {{ form_errors(form.subject) }}
                                </div>
                                {{ form_widget(form.subject, {'attr': {'class': 'form-input'}}) }}
                            </div>

                            <div class="form-field">
                                <div class="form-label">
                                    {{ form_label(form.message) }}
                                    {{ form_errors(form.message) }}
                                </div>
                                {{ form_widget(form.message, {'attr': {'class': 'form-textarea'}}) }}
                            </div>

                            <div class="form-field">
                                <p class="form-condition">En envoyant ce formulaire, vous acceptez que l’association Radiance stocke et
                                    utilise vos données personnelles afin de vous contacter. Nous nous engageons à ne pas communiquer vos
                                    coordonnées à des tiers ni à les utiliser à des fins publicitaires.
                                </p>
                            </div>

                            <div class="form-action">
                                {% for message in successMessages %}
                                <span class="form-response flash-success">
                                    {{ message }}
                                </span>
                                {% endfor %}

                                {% for message in errorMessages %}
                                <span class="form-response flash-error">
                                    {{ message }}
                                </span>
                                {% endfor %}

                                {% if successMessages is empty %}
                                <button type="submit" class="button button-accent">
                                    Envoyer
                                </button>
                                {% endif %}
                            </div>

                            {{ form_end(form) }}
                    </turbo-frame>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
