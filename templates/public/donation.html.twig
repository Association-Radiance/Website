{% extends 'base.html.twig' %}

{% block title %}
    Donation - Association Radiance
{% endblock %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('styles/donation.css') }}" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('hello_asso_iframe.js') }}"></script>
{% endblock %}

{% block main %}
    <section class="section">
        <div class="section-container section-container-1fr-auto">
            <div class="section-content">
                {{ include('/public/donation/_presentation.html.twig') }}

                {{ include('/public/donation/_donation-goal.html.twig') }}
            </div>

            <div class="section-content">
                <iframe
                    class="donation-form"
                    id="haWidgetLight"
                    allowtransparency="true"
                    allow="payment"
                    scrolling="no"
                    src="https://www.helloasso-sandbox.com/associations/association-culturelle-radiance-radiance/formulaires/1/widget?view=form"
                ></iframe>
            </div>
        </div>
    </section>
{% endblock %}
