{% extends 'base.html.twig' %}

{% block title %}
    Association Radiance
{% endblock %}

{% block main %}
    <section
        class="section section-background-accent"
        style="background-image: url({{ asset('images/background/background-banner.webp') }})"
    >
        <div class="section-container">
            {{ include('/public/_home/_banner.html.twig') }}
        </div>
    </section>

    <section class="section">
        <div class="section-container">
            {{ include('/public/_home/_about.html.twig') }}
        </div>
    </section>

    <section
        class="section section-background"
        style="background-image: url({{ asset('images/background/background-partner.webp') }})"
    >
        <div class="section-container">
            {{ include('/public/_home/_partner.html.twig') }}
        </div>
    </section>

    <section class="section">
        <div class="section-container">
            {{ include('/public/_home/_engagement.html.twig') }}
        </div>
    </section>
{% endblock %}
