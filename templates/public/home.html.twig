{% extends 'base.html.twig' %}

{% block title %}
    Édition 2026 - Association Radiance
{% endblock %}

{% block main %}
    <section
        class="section section-background-accent"
        style="background-image: url({{ asset('images/background/background-banner.webp') }})"
    >
        <div class="section-container">
            {{ include('/public/home/_banner.html.twig') }}
        </div>
    </section>

    <section class="section">
        <div class="section-container">
            {{ include('/public/home/_about.html.twig') }}
        </div>
    </section>

    <section
        class="section section-background"
        style="background-image: url({{ asset('images/background/background-partner.webp') }})"
    >
        <div class="section-container">
            {{ include('/public/home/_partner.html.twig') }}
        </div>
    </section>

    <section class="section">
        <div class="section-container">
            {{ include('/public/home/_engagement.html.twig') }}
        </div>
    </section>
{% endblock %}
